{
    "position": "top",
    "height": 40,
    "start": [
        {
            "type": "workspaces"
        }
    ],
    "center": [
        {
            "type": "clock",
            "format": "%a %b %d  %H:%M:%S"
        }
    ],
    "end": [
        {
            "type": "sys_info",
            "format": [
                "CPU: {cpu_percent}%",
                "RAM: {memory_percent}%",
                "Temp: {temp_c}°C"
            ]
        },
        {
            "type": "network"
        },
        {
            "type": "tray"
        }
    ]
}
