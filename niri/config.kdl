// Niri configuration file styled with Cursor Design Principles, Hybrid Auto-Theming, and Fluid macOS UI physics

// Execute on startup
spawn-at-startup "swww-daemon"
spawn-at-startup "ironbar"
// Clipboard Watcher
spawn-at-startup "wl-paste" "--watch" "cliphist" "store"
// Idle Daemon (Screen off after 5 mins, sleep after 15 mins)
spawn-at-startup "swayidle" "-w" "timeout" "300" "niri msg action power-off-monitors" "resume" "niri msg action power-on-monitors" "timeout" "900" "systemctl suspend"

input {
    keyboard {
        xkb {
            // Layouts
        }
    }
}

layout {
    gaps 16

    center-focused-column "never"

    default-column-width { proportion 0.5; }

    // Focus ring and borders
    // Default fallback to Cursor Orange / Hairline
    focus-ring {
        active-color "#f54e00"
        inactive-color "#cfcdc4"
        width 1
    }

    border {
        active-color "#f54e00"
        inactive-color "#cfcdc4"
        width 1
    }

    // Depth mechanics: Native soft offset shadows for verticality
    shadow {
        on
        softness 30
        spread 0
        offset x=0 y=10
        color "#00000080"
    }

    // Smooth native rounded corners for flat transparency depth
    default-workspace-clear {
        geometry-corner-radius 12
        clip-to-geometry true
    }
}

// Window rules for transparency and geometry
window-rule {
    // Glassmorphism mechanics: Transparency relying on cached static wallpaper blur
    opacity 0.95
    geometry-corner-radius 12
    clip-to-geometry true
}

// Physics of Fluidity: Spring mass and exponential easing
animations {
    horizontal-view-center {
        spring damping-ratio=0.85 stiffness=800 epsilon=0.0001
    }

    workspace-switch {
        spring damping-ratio=0.85 stiffness=800 epsilon=0.0001
    }

    window-open {
        duration-ms 250
        curve "ease-out-expo"
    }

    window-close {
        duration-ms 250
        curve "ease-out-expo"
    }
}

// Keybindings (Windows Translation schema)
binds {
    // Application Launching
    Mod+S { spawn "fuzzel"; }
    Mod+E { spawn "thunar"; }
    Mod+T { spawn "foot"; }

    // Utilities
    Mod+W { spawn "~/.config/scripts/select-wallpaper.sh"; }

    // Hardware Control (Direct mapping)
    F2 { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    F3 { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    F6 { spawn "brightnessctl" "set" "5%-"; }
    F7 { spawn "brightnessctl" "set" "5%+"; }

    // Window Management
    Alt+F4 { close-window; }

    // Snap/Focus columns
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }

    // Clipboard History (Win + V)
    Mod+V { spawn "bash" "-c" "cliphist list | fuzzel --dmenu --prompt 'Clipboard 󰅍 ' | cliphist decode | wl-copy"; }

    // Emoji Picker (Win + .)
    Mod+Period { spawn "bash" "-c" "BEMOJI_PICKER_CMD='fuzzel --dmenu --prompt \"Emoji 󰞅 \"' bemoji -t"; }

    // Re-bind consume-window-into-column to Shift+V since Mod+V is now clipboard
    Mod+Shift+V { consume-window-into-column; }
}
