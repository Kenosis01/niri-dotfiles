// Niri configuration file styled with Cursor Design Principles and Hybrid Auto-Theming

// Execute on startup
spawn-at-startup "swww-daemon"
spawn-at-startup "ironbar"
// Initial theme loading (fallback to a dark wallpaper if it exists)
spawn-at-startup "/bin/bash" "-c" "~/.config/scripts/change-wallpaper.sh ~/Pictures/Wallpapers/Dark/cursor_ink_lavender.png"

input {
    keyboard {
        xkb {
            // Layouts
        }
    }
}

layout {
    gaps 16

    center-focused-column "never"

    default-column-width { proportion 0.5; }

    // Focus ring and borders
    // Default fallback to Cursor Orange / Hairline
    focus-ring {
        active-color "#f54e00"
        inactive-color "#cfcdc4"
        width 1
    }

    border {
        active-color "#f54e00"
        inactive-color "#cfcdc4"
        width 1
    }

    // Smooth native rounded corners for flat transparency depth
    default-workspace-clear {
        geometry-corner-radius 12
        clip-to-geometry true
    }
}

// Window rules for transparency and geometry
window-rule {
    // Enable flat transparency to provide depth without blur
    opacity 0.95
    geometry-corner-radius 12
    clip-to-geometry true
}

// Keybindings (Windows Translation schema)
binds {
    // Application Launching
    Mod+S { spawn "fuzzel"; }
    Mod+E { spawn "thunar"; }
    Mod+T { spawn "foot"; }

    // Hardware Control (Direct mapping)
    F2 { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    F3 { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    F6 { spawn "brightnessctl" "set" "5%-"; }
    F7 { spawn "brightnessctl" "set" "5%+"; }

    // Window Management
    Alt+F4 { close-window; }

    // Snap/Focus columns
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }

    // Consume window into column to allow vertical stacking
    Mod+V { consume-window-into-column; }
}
